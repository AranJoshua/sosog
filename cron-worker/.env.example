# This Worker only needs one secret, set with `wrangler secret put
# DEPLOY_HOOK_URL` from inside cron-worker/ (never as a plain var, it's a
# bearer credential, anyone with it can trigger a rebuild). There's no
# local .env use for this package; this file just documents the name.

# The main site Worker's Deploy Hook URL (Cloudflare dashboard > the
# sosog Worker > Settings > Builds > Deploy Hooks).
DEPLOY_HOOK_URL=
