---
import ProvinceModel from './ProvinceModel.astro';

interface Props {
  pins: { latitude: number; longitude: number }[];
  documented: string[];
}
const { pins, documented } = Astro.props;
---
<section class="wall-cream overflow-hidden" aria-label="The map">
  <div class="mx-auto grid max-w-[84rem] items-center gap-10 px-5 py-24 sm:px-8 lg:grid-cols-[0.95fr_1.05fr] lg:py-36">
    <div class="relative z-10">
      <h2 class="display-lg max-w-[11ch]">See where each one stands</h2>
      <p class="lead mt-7 text-maroon/85">
        The map is a cut model of the province. Choose a municipality to raise it from the rest, then open any marker to see the structure's photo, its location, and a summary of its technical description.
      </p>
      <a href="/map" class="btn btn-maroon mt-12">Open the map</a>
    </div>
    <div class="relative mx-auto block w-full max-w-[40rem] lg:max-w-none lg:pr-6">
      <ProvinceModel pins={pins} documented={documented} focusable />
    </div>
  </div>
</section>
