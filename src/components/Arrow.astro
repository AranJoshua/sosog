---
import { ARROW_INNER, ARROW_VIEWBOX } from './IronArrow';
interface Props {
  dir?: 'right' | 'left' | 'down';
}
const { dir = 'right' } = Astro.props;
---
<!-- One iron arrow. On hover it nudges a few pixels the way it points (see .arr in global.css). -->
<span class="arr" data-dir={dir} aria-hidden="true">
  <svg viewBox={ARROW_VIEWBOX} set:html={ARROW_INNER} />
</span>
