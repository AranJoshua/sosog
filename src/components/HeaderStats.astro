---
interface Props {
  items: { n: number | string; label: string }[];
}
const { items } = Astro.props;
---
<dl class="mt-10 flex flex-wrap gap-x-12 gap-y-6">
  {items.map((s) => (
    <div>
      <dt class="figure text-[clamp(2.4rem,5vw,3.2rem)] leading-none">{s.n}</dt>
      <dd class="mt-2.5 max-w-[10rem] text-[0.98rem] leading-snug opacity-75">{s.label}</dd>
    </div>
  ))}
</dl>
