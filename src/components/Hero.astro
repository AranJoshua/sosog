---
export interface HeroSlide {
  id: string;
  name: string;
  municipality: string;
  year: string | null;
  photo: string;
  thumb: string | null;
}
interface Props {
  slides: HeroSlide[];
  structureCount: number;
  municipalityCount: number;
  earliest: number | null;
}
const { slides, structureCount, municipalityCount, earliest } = Astro.props;
const letters = 'SOSOG'.split('');
const stats = [
  { n: structureCount, label: 'structures documented' },
  { n: municipalityCount, label: 'municipalities visited' },
  ...(earliest ? [{ n: earliest, label: 'year of the oldest' }] : [])
];
---
<section class="threshold" data-threshold aria-label="SOSOG">
  <div class="th-stick">
    <div class="th-wall wall-ink"></div>

    <div class="th-step th-step-2" aria-hidden="true"></div>
    <div class="th-step th-step-1" aria-hidden="true"></div>

    <div class="th-window" data-window>
      <div class="th-slides">
        {slides.map((s, i) => (
          <div class="th-slide" data-slide data-active={i === 0 ? '' : undefined}>
            <img src={s.photo} alt="" width="1600" height="1200" decoding="async" fetchpriority={i === 0 ? 'high' : 'auto'} />
          </div>
        ))}
      </div>
      <div class="th-shade"></div>
    </div>
    <div class="th-scrim" aria-hidden="true"></div>

    <div class="th-copy">
      <h1 class="th-word" aria-label="SOSOG" style="font-family: var(--font-wordmark)">
        {letters.map((ch, i) => (
          <span class="th-ch" aria-hidden="true"><span style={`--i:${i}`}>{ch}</span></span>
        ))}
      </h1>
      <p class="th-lead">The old schools, churches, ancestral houses, lighthouses, and ruins of Sorsogon province, recorded one structure at a time.</p>
      <dl class="th-stats">
        {stats.map((s) => (
          <div>
            <dt class="th-num figure" data-count={s.n}>{s.n}</dt>
            <dd>{s.label}</dd>
          </div>
        ))}
      </dl>
      <div class="th-actions">
        <a href="#explore" class="btn">Explore the province</a>
        <a href="/map" class="btn btn-navy">Open the map</a>
      </div>
    </div>

    <div class="th-dock" data-dock>
      <div class="th-captions">
        {slides.map((s, i) => (
          <div class="th-caption" data-caption data-active={i === 0 ? '' : undefined} inert={i !== 0}>
            <p class="th-tag">{[s.municipality, s.year].filter(Boolean).join(', ')}</p>
            <p class="th-name font-display">{s.name}</p>
            <p class="mt-4 flex flex-wrap gap-x-8 gap-y-2 text-[1.02rem] font-bold">
              <a href={`/structures/${s.id}`} data-sp={s.id} class="group"><span class="link-draw">Read its history</span></a>
              <a href={`/map?s=${s.id}`} class="group"><span class="link-draw">Find it on the map</span></a>
            </p>
          </div>
        ))}
      </div>
      {slides.length > 1 && (
        <ol class="th-thumbs" aria-label="Featured structures">
          {slides.map((s, i) => (
            <li>
              <button type="button" class="th-thumb" data-dot={i} aria-label={`Show ${s.name}`} aria-current={i === 0 ? 'true' : undefined}>
                {s.thumb ? <img src={s.thumb} alt="" width="96" height="72" loading="lazy" /> : <span></span>}
              </button>
            </li>
          ))}
        </ol>
      )}
    </div>
  </div>
</section>

<style>
  .threshold {
    --e: 0;
    --rad: 999px;
    position: relative;
    background: var(--color-ink);
  }
  /* Without script, or when motion is reduced, the doorway is simply open. */
  :global(html:not(.js)) .threshold {
    --e: 1;
    --rad: 0px;
  }
  @media (prefers-reduced-motion: reduce) {
    .threshold {
      --e: 1;
      --rad: 0px;
    }
  }
  .th-stick {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: min(46rem, 100svh);
    overflow: hidden;
    color: var(--color-cream);
  }
  .th-wall {
    position: absolute;
    inset: 0;
  }

  /* ---------- the window: an arched doorway onto the structure ---------- */
  .th-step,
  .th-scrim {
    display: none;
  }
  .th-window {
    position: relative;
    z-index: 1;
    order: 2;
    margin: 2.4rem 2rem 0;
    min-height: 34rem;
    overflow: hidden;
    border-radius: 999px 999px 0 0;
    background: var(--color-navy);
    box-shadow: 0 0 0 0.9rem var(--color-cream), 0 0 0 2.2rem var(--color-maroon);
  }
  .th-slides,
  .th-slide,
  .th-shade {
    position: absolute;
    inset: 0;
  }
  .th-slide {
    opacity: 0;
    transition: opacity 1.1s ease;
  }
  .th-slide[data-active] {
    opacity: 1;
    z-index: 1;
  }
  .th-slide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.12);
    transition: transform 14s linear;
  }
  .th-slide[data-active] img {
    transform: scale(1);
  }
  .th-shade {
    z-index: 2;
    background: linear-gradient(to top, color-mix(in srgb, var(--color-ink) 90%, transparent) 0%, color-mix(in srgb, var(--color-ink) 40%, transparent) 30%, transparent 60%);
  }

  /* ---------- copy ---------- */
  .th-copy {
    position: relative;
    z-index: 4;
    order: 1;
    padding: 3.5rem 1.25rem 0;
  }
  .th-word {
    display: flex;
    font-size: clamp(5.2rem, 24vw, 8rem);
    line-height: 0.88;
  }
  .th-ch {
    display: block;
    overflow: hidden;
    padding-bottom: 0.06em;
  }
  :global(html.js) .th-ch > span {
    display: block;
    transform: translateY(108%);
    animation: th-letter 1.2s var(--ease-out) calc(0.1s + var(--i) * 85ms) forwards;
  }
  .th-lead {
    max-width: 30rem;
    margin-top: 1.5rem;
    font-size: 1.2rem;
    line-height: 1.55;
    font-weight: 400;
    color: color-mix(in srgb, var(--color-cream) 92%, transparent);
  }
  .th-stats {
    display: flex;
    gap: 2.4rem;
    margin-top: 2.4rem;
  }
  .th-num {
    font-size: clamp(2.5rem, 8vw, 3.4rem);
    line-height: 1;
  }
  .th-stats dd {
    margin-top: 0.55rem;
    max-width: 9rem;
    font-size: 0.95rem;
    line-height: 1.3;
    color: color-mix(in srgb, var(--color-cream) 78%, transparent);
  }
  .th-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem 1.8rem;
    margin-top: 3rem;
    padding-left: 5px;
  }
  :global(html.js) .th-lead,
  :global(html.js) .th-stats,
  :global(html.js) .th-actions {
    opacity: 0;
    transform: translateY(0.75rem);
    animation: th-in 0.6s ease-out forwards;
  }
  :global(html.js) .th-lead {
    animation-delay: 0.35s;
  }
  :global(html.js) .th-stats {
    animation-delay: 0.45s;
  }
  :global(html.js) .th-actions {
    animation-delay: 0.55s;
  }

  /* ---------- dock: caption and picker, one tidy block ---------- */
  .th-dock {
    position: relative;
    z-index: 4;
    order: 3;
    padding: 3.4rem 2rem 2.4rem;
  }
  .th-captions {
    display: grid;
  }
  .th-caption {
    grid-area: 1 / 1;
    opacity: 0;
    transform: translateY(0.8rem);
    transition: opacity 0.4s, transform 0.4s;
    pointer-events: none;
  }
  .th-caption[data-active] {
    opacity: 1;
    transform: none;
    transition: opacity 0.9s var(--ease-out) 0.3s, transform 1s var(--ease-out) 0.3s;
    pointer-events: auto;
  }
  .th-tag {
    display: inline-block;
    background: var(--color-cream);
    color: var(--color-maroon);
    padding: 0.3rem 0.8rem;
    font-size: 0.95rem;
    font-weight: 700;
  }
  .th-name {
    margin-top: 0.9rem;
    font-size: clamp(2rem, 8vw, 2.8rem);
    line-height: 1;
  }
  .th-thumbs {
    display: flex;
    gap: 0.8rem;
    margin-top: 1.9rem;
  }
  .th-thumb {
    position: relative;
    display: block;
    width: 3.4rem;
    height: 4.4rem;
    overflow: hidden;
    border-radius: 999px 999px 0 0;
    background: var(--color-navy);
    opacity: 0.62;
    transition: opacity 0.4s, transform 0.5s var(--ease-out), box-shadow 0.4s;
  }
  .th-thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .th-thumb::after {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 6px;
    background: var(--color-cream);
    transform: scaleX(0);
    transform-origin: left;
  }
  .th-thumb:hover {
    opacity: 0.95;
    transform: translateY(-4px);
  }
  .th-thumb[aria-current='true'] {
    opacity: 1;
    box-shadow: 0 0 0 4px var(--color-cream);
    transform: translateY(-4px);
  }
  .th-thumb[aria-current='true']::after {
    animation: th-time 8s linear forwards;
  }
  [data-threshold][data-paused] .th-thumb[aria-current='true']::after {
    animation-play-state: paused;
  }
  @keyframes th-time {
    to {
      transform: scaleX(1);
    }
  }

  /* ---------- desktop: the doorway opens on its own, then the photograph fills the screen ---------- */
  @media (min-width: 900px) {
    .th-stick {
      display: block;
      height: calc(100svh - var(--header-h));
      min-height: 38rem;
    }
    .th-window {
      position: absolute;
      inset: 0;
      margin: 0;
      min-height: 0;
      border-radius: 0;
      box-shadow: none;
      background: var(--color-ink);
      clip-path: inset(
        calc(11% * (1 - var(--e))) calc(15% * (1 - var(--e))) 0 calc(50% * (1 - var(--e))) round var(--rad) var(--rad) 0 0
      );
    }
    /* The doorway is stepped like a colonial portal: a cream architrave and a maroon archivolt surround the photograph and fall away as it opens. */
    .th-step {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 0;
      --x: 0px;
      clip-path: inset(
        calc(11% * (1 - var(--e)) - var(--x) * (1 - var(--e))) calc(15% * (1 - var(--e)) - var(--x) * (1 - var(--e))) 0 calc(50% * (1 - var(--e)) - var(--x) * (1 - var(--e))) round calc(var(--rad) + var(--x) * (1 - var(--e))) calc(var(--rad) + var(--x) * (1 - var(--e))) 0 0
      );
    }
    .th-step-1 {
      --x: 20px;
      background: var(--color-cream);
    }
    .th-step-2 {
      --x: 52px;
      background: var(--color-maroon);
      background-image: var(--grain);
    }
    .th-slides {
      transform: scale(calc(1.3 - 0.3 * var(--e)));
    }
    /* Once the photograph is open, a wash from the left keeps the type readable over it. */
    .th-scrim {
      display: block;
      position: absolute;
      inset: 0;
      z-index: 2;
      opacity: var(--e);
      background: linear-gradient(to right, color-mix(in srgb, var(--color-ink) 94%, transparent) 0%, color-mix(in srgb, var(--color-ink) 82%, transparent) 30%, color-mix(in srgb, var(--color-ink) 30%, transparent) 58%, transparent 82%);
    }
    .th-copy {
      position: absolute;
      inset: 0 auto 0 0;
      width: 50vw;
      padding: 0 0 0 max(2rem, calc((100vw - 84rem) / 2 + 2rem));
      display: flex;
      flex-direction: column;
      justify-content: center;
    }
    .th-word {
      font-size: clamp(6rem, 12vw, 11.5rem);
    }
    .th-lead {
      font-size: clamp(1.1rem, 1.4vw, 1.3rem);
    }
    .th-dock {
      position: absolute;
      right: max(2rem, calc((100vw - 84rem) / 2 + 2rem));
      bottom: clamp(2rem, 6vh, 3.4rem);
      width: min(27rem, 38vw);
      padding: 0;
      opacity: clamp(0, calc((var(--e) - 0.72) * 3.6), 1);
      transform: translateY(calc((1 - var(--e)) * 28px));
    }
    .th-name {
      font-size: clamp(2.2rem, 3.4vw, 3.4rem);
    }
  }

  @keyframes th-letter {
    to {
      transform: none;
    }
  }
  @keyframes th-in {
    to {
      opacity: 1;
      transform: none;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .th-slide img {
      transform: none !important;
      transition: none;
    }
    .th-thumb[aria-current='true']::after {
      animation: none;
    }
    :global(html.js) .th-ch > span,
    :global(html.js) .th-lead,
    :global(html.js) .th-stats,
    :global(html.js) .th-actions {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-threshold]').forEach((root) => {
    const stick = root.querySelector<HTMLElement>('.th-stick')!;
    const dock = root.querySelector<HTMLElement>('[data-dock]')!;
    const slides = Array.from(root.querySelectorAll<HTMLElement>('[data-slide]'));
    const captions = Array.from(root.querySelectorAll<HTMLElement>('[data-caption]'));
    const dots = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-dot]'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)');
    const wide = window.matchMedia('(min-width: 900px)');
    let index = 0;

    // ---- the doorway: closed (an arch on the wall) to open (the photograph fills the screen) ----
    const setOpen = (e: number) => {
      root.style.setProperty('--e', e.toFixed(4));
      // The arch's radius is half the opening's width, and it flattens to nothing as the door opens.
      const openWidth = stick.offsetWidth * (1 - 0.65 * (1 - e));
      root.style.setProperty('--rad', `${Math.max(0, (openWidth / 2) * (1 - e * 1.04))}px`);
      dock.inert = wide.matches && e < 0.8;
    };
    const seen = (() => {
      try {
        return sessionStorage.getItem('sosog-door') === '1';
      } catch {
        return false;
      }
    })();
    let current = 0;
    if (!wide.matches || reduced.matches) {
      root.style.removeProperty('--e');
      root.style.removeProperty('--rad');
      dock.inert = false;
    } else if (seen || window.scrollY > 120) {
      current = 1;
      setOpen(1);
    } else {
      setOpen(0);
      // Let the letters and copy arrive, then swing the door open once per visit.
      const delay = 1250;
      const duration = 2000;
      const start = performance.now() + delay;
      const step = (now: number) => {
        const t = Math.min(1, Math.max(0, (now - start) / duration));
        current = t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
        setOpen(current);
        if (t < 1) requestAnimationFrame(step);
        else {
          try {
            sessionStorage.setItem('sosog-door', '1');
          } catch {
            /* private mode */
          }
        }
      };
      requestAnimationFrame(step);
    }
    const onChange = () => {
      if (!wide.matches || reduced.matches) {
        root.style.removeProperty('--e');
        root.style.removeProperty('--rad');
        dock.inert = false;
      } else setOpen(1);
    };
    wide.addEventListener('change', onChange);
    window.addEventListener('resize', () => wide.matches && !reduced.matches && setOpen(Math.max(current, 0)));

    // ---- slides: the bar filling along the current thumbnail is the timer ----
    const show = (next: number) => {
      index = (next + slides.length) % slides.length;
      slides.forEach((s, i) => (i === index ? s.setAttribute('data-active', '') : s.removeAttribute('data-active')));
      captions.forEach((c, i) => {
        if (i === index) c.setAttribute('data-active', '');
        else c.removeAttribute('data-active');
        c.inert = i !== index;
      });
      dots.forEach((d, i) => (i === index ? d.setAttribute('aria-current', 'true') : d.removeAttribute('aria-current')));
    };
    dots.forEach((d, i) => d.addEventListener('click', () => show(i)));
    if (slides.length > 1 && !reduced.matches) {
      root.addEventListener('animationend', (event) => {
        if ((event as AnimationEvent).animationName === 'th-time') show(index + 1);
      });
      const pause = (on: boolean) => root.toggleAttribute('data-paused', on);
      dock.addEventListener('pointerenter', () => pause(true));
      dock.addEventListener('pointerleave', () => pause(false));
      dock.addEventListener('focusin', () => pause(true));
      dock.addEventListener('focusout', () => pause(false));
      document.addEventListener('visibilitychange', () => pause(document.hidden));
    }
  });
</script>
