---
const links = [
  { href: '/', label: 'Home' },
  { href: '/map/', label: 'Map' },
  { href: '/technical/', label: 'Technical Description' },
  { href: '/history/', label: 'History' },
  { href: '/stories/', label: 'Feature Stories' },
  { href: '/glimpse/', label: 'Glimpse of Sorsogon' },
  { href: '/about/', label: 'About Us' }
];

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const bare = (href: string) => href.replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === bare(href) || path.startsWith(`${bare(href)}/`));
// The Explore and structure pages belong to the home section of the site.
const onExplore = path === '/explore' || path.startsWith('/explore/') || path.startsWith('/structures/');
const current = (href: string) => isActive(href) || (onExplore && href === '/');
---
<header class="site-header fixed inset-x-0 top-0 z-50 bg-ink" data-header>
  <nav class="mx-auto flex h-[var(--header-h)] max-w-[84rem] items-end justify-between gap-6 px-5 sm:px-8" aria-label="Main">
    <a href="/" class="wordmark relative z-[70] flex h-full items-end pb-[0.7rem] leading-none text-cream" aria-label="SOSOG, home" style="font-family: var(--font-wordmark)">
      <span class="text-[1.95rem] tracking-[0.03em]">SOSOG</span>
    </a>

    <ul class="nav-links relative hidden h-[3.1rem] items-stretch gap-1 lg:flex" data-nav-links>
      {links.map((link) => (
        <li class="relative">
          <a href={link.href} aria-current={current(link.href) ? 'page' : undefined} class="nav-link relative z-[1] flex h-full items-center px-4 text-[0.97rem] font-semibold">
            {link.label}
          </a>
        </li>
      ))}
    </ul>

    <button type="button" class="menu-btn relative z-[70] -mr-2 flex h-full items-center gap-3 px-2 lg:hidden" aria-expanded="false" aria-controls="menu-panel" data-menu-btn>
      <span class="text-[0.97rem] font-semibold" data-menu-label>Menu</span>
      <span class="menu-icon relative block h-4 w-7" aria-hidden="true"><i></i><i></i><i></i></span>
    </button>
  </nav>

  <div id="menu-panel" class="menu-panel wall-maroon fixed inset-0 z-[60] lg:hidden" data-menu-panel inert>
    <div class="mx-auto flex h-full max-w-[84rem] flex-col justify-between px-5 pb-8 pt-[calc(var(--header-h)+1rem)] sm:px-8">
      <ul class="menu-links flex flex-col gap-1.5">
        {links.map((link, i) => (
          <li style={`--i:${i}`}>
            <a
              href={link.href}
              aria-current={current(link.href) ? 'page' : undefined}
              class="menu-link flex items-center justify-between gap-4 px-4 py-3.5 font-display text-[clamp(1.7rem,7vw,2.5rem)] leading-none"
            >
              <span>{link.label}</span>
              <span class="menu-mark" aria-hidden="true"></span>
            </a>
          </li>
        ))}
      </ul>
      <p class="menu-foot text-[0.98rem] text-cream/70">Historical structures of Sorsogon province. A BSCE project of Bicol University.</p>
    </div>
  </div>
</header>

<style>
  .nav-link {
    color: var(--color-cream);
    transition: color 0.2s ease-out, background-color 0.2s ease-out;
  }
  /* The tab you are on is a solid cream arch-topped plate, drawn by the server so it is in place from the first paint. It carries a view-transition name, so moving to another tab makes the browser carry the plate across to it (see global.css). */
  .nav-link[aria-current='page'] {
    background: var(--color-cream);
    color: var(--color-maroon);
    border-radius: 999px 999px 0 0;
    view-transition-name: nav-tab;
  }
  /* While the photo viewer on the Glimpse page opens or closes, the whole page dims, so the plate must not float above it. */
  :global(html[data-vt]) .nav-link[aria-current='page'] {
    view-transition-name: none;
  }
  /* Pointing at another link only tints it. */
  .nav-link:not([aria-current='page']):hover,
  .nav-link:not([aria-current='page']):focus-visible {
    background: color-mix(in srgb, var(--color-cream) 16%, transparent);
    border-radius: 999px 999px 0 0;
  }

  .menu-icon i {
    position: absolute;
    left: 0;
    right: 0;
    height: 3px;
    background: var(--color-cream);
    transition: transform 0.55s var(--ease-out), top 0.4s var(--ease-out), opacity 0.2s;
  }
  .menu-icon i:nth-child(1) {
    top: 0;
  }
  .menu-icon i:nth-child(2) {
    top: 6.5px;
  }
  .menu-icon i:nth-child(3) {
    top: 13px;
  }
  [data-header][data-menu-open] .menu-icon i:nth-child(1) {
    top: 6.5px;
    transform: rotate(45deg);
  }
  [data-header][data-menu-open] .menu-icon i:nth-child(2) {
    opacity: 0;
  }
  [data-header][data-menu-open] .menu-icon i:nth-child(3) {
    top: 6.5px;
    transform: rotate(-45deg);
  }

  /* The phone menu opens as a growing circle from the button, then the links rise in turn. */
  .menu-panel {
    clip-path: circle(0px at calc(100% - 3.2rem) 2.25rem);
    visibility: hidden;
    transition: clip-path 0.5s var(--ease-arch), visibility 0s 0.5s;
  }
  [data-header][data-menu-open] .menu-panel {
    clip-path: circle(160% at calc(100% - 3.2rem) 2.25rem);
    visibility: visible;
    transition: clip-path 0.55s var(--ease-arch), visibility 0s;
  }
  .menu-links > li,
  .menu-foot {
    opacity: 0;
    transform: translateY(1.5rem);
    transition: opacity 0.3s, transform 0.3s;
  }
  [data-header][data-menu-open] .menu-links > li,
  [data-header][data-menu-open] .menu-foot {
    opacity: 1;
    transform: none;
    transition: opacity 0.35s ease-out, transform 0.45s var(--ease-out);
    transition-delay: calc(0.12s + var(--i, 7) * 28ms);
  }
  .menu-link {
    transition: background-color 0.35s, color 0.35s;
  }
  .menu-link:hover,
  .menu-link[aria-current='page'] {
    background: var(--color-cream);
    color: var(--color-maroon);
  }
  /* The current page is marked with a solid lozenge, the bead from the arrow's shaft. */
  .menu-mark {
    width: 0.9rem;
    height: 0.9rem;
    background: currentColor;
    transform: rotate(45deg) scale(0);
    transition: transform 0.5s var(--ease-out);
  }
  .menu-link[aria-current='page'] .menu-mark {
    transform: rotate(45deg) scale(1);
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const root = document.documentElement;

    // Phone and tablet menu.
    const btn = header.querySelector<HTMLButtonElement>('[data-menu-btn]');
    const panel = header.querySelector<HTMLElement>('[data-menu-panel]');
    const label = header.querySelector<HTMLElement>('[data-menu-label]');
    if (btn && panel) {
      const setOpen = (open: boolean) => {
        header.toggleAttribute('data-menu-open', open);
        btn.setAttribute('aria-expanded', String(open));
        if (label) label.textContent = open ? 'Close' : 'Menu';
        panel.inert = !open;
        root.style.overflow = open ? 'hidden' : '';
        if (open) window.setTimeout(() => panel.querySelector<HTMLElement>('a')?.focus({ preventScroll: true }), 420);
      };
      btn.addEventListener('click', () => setOpen(btn.getAttribute('aria-expanded') !== 'true'));
      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape' && header.hasAttribute('data-menu-open')) {
          setOpen(false);
          btn.focus();
        }
      });
      window.matchMedia('(min-width: 1024px)').addEventListener('change', (e) => e.matches && setOpen(false));
      panel.addEventListener('click', (event) => {
        if ((event.target as HTMLElement).closest('a')) setOpen(false);
      });
    }
  }
</script>
