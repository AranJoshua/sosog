---
import { pickVariant, extractPullQuote } from '../lib/variant';
import { getStructurePhoto } from '../lib/photos';
import { slugify } from '../lib/text';
import { INTERVENTION_LEVELS, parseIntervention, interventionLabel } from '../lib/intervention';
import { INTERVENTION_ART } from '../lib/intervention-art';

interface Props {
  id: string;
  name: string;
  municipality: string;
  photo?: string | null;
  yearBuilt?: string | null;
  classification?: string | null;
  materials?: string | null;
  occupancy?: string | null;
  interventionLevel?: string | null;
  history: string | null;
  technicalDescription: string | null;
  featureStory: string | null;
}

const { id, name, municipality, photo, yearBuilt, classification, materials, occupancy, interventionLevel, history, technicalDescription, featureStory } = Astro.props;
const photoKey = photo ?? id;

// The sheet words for the level of intervention are read into one of the eight levels; when they name none, the plaque shows the words as typed and the level gauge on the Technical Description sheet stays out.
const intervention = parseIntervention(interventionLevel);
const facts = [
  { label: 'Year built', value: yearBuilt, level: undefined as number | undefined },
  { label: 'Classification', value: classification, level: undefined },
  { label: 'Materials', value: materials, level: undefined },
  { label: 'Occupancy', value: occupancy, level: undefined },
  { label: 'Intervention', value: interventionLabel(interventionLevel), level: intervention?.level }
].filter((f) => f.value);

// One photo per structure, so the same image fills the decorative slots the picked scrapbook layout calls for.
const heroPhoto = getStructurePhoto(photoKey, 'large');
const insetPhoto = getStructurePhoto(photoKey, 'thumb');

// Tabs: History is the default; the feature story tab only exists when a story has been written.
const SHEET_TABS = ['--tab-bg: var(--color-cream); --tab-fg: var(--color-maroon)', '--tab-bg: var(--color-navy); --tab-fg: var(--color-cream)', '--tab-bg: var(--color-ink); --tab-fg: var(--color-cream)'];
const sheetIndex = pickVariant(name, 3);
const tabs = [
  { key: 'history', label: 'History', tone: SHEET_TABS[0] },
  ...(featureStory ? [{ key: 'story', label: 'Feature Story', tone: SHEET_TABS[sheetIndex] }] : []),
  { key: 'technical', label: 'Technical Description', tone: SHEET_TABS[1] }
];

// Feature stories get a scrapbook look: a sheet colour, a photo layout, and a pull quote, each picked from the structure's own name so the same structure always renders the same way. All three sheets use the site palette only.
const SHEETS = [
  { sheet: 'paper', quote: 'text-maroon', tape: 'bg-navy/70', ink: 'text-maroon' },
  { sheet: 'wall-navy-mid', quote: 'text-cream', tape: 'bg-cream/75', ink: 'text-cream' },
  { sheet: 'wall-ink', quote: 'text-cream', tape: 'bg-maroon-light/80', ink: 'text-cream' }
] as const;
const accent = SHEETS[pickVariant(name, SHEETS.length)];
const photoLayout = pickVariant(`${name}-layout`, 3);
const pullQuote = featureStory && featureStory.length > 650 ? extractPullQuote(featureStory) : null;
const storyIsShort = !!featureStory && featureStory.length <= 650;
---
<article>
  <header class="wall-navy">
    <div class="mx-auto max-w-[84rem] px-5 pb-16 pt-10 sm:px-8 sm:pt-14">
      <nav aria-label="Breadcrumb" class="flex flex-wrap items-center gap-x-3 gap-y-1 text-[1rem] font-medium">
        <a href="/explore" class="link-draw">Explore</a>
        <span class="text-cream/35" aria-hidden="true">/</span>
        <a href={`/explore/${slugify(municipality)}`} class="link-draw">{municipality}</a>
      </nav>

      <div class="mt-9 grid gap-10 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,1fr)] lg:items-stretch lg:gap-16">
        <figure class="print-frame" style="view-transition-name: sp-hero">
          {heroPhoto ? (
            <div class="relative lg:h-full"><img src={heroPhoto} alt={name} width="1600" height="1200" decoding="async" fetchpriority="high" class="aspect-[4/3] w-full object-cover lg:absolute lg:inset-0 lg:aspect-auto lg:h-full" /></div>
          ) : (
            <div class="print-empty">No photo available</div>
          )}
        </figure>

        <div class="flex flex-col justify-between gap-9">
          <h1 class="display-lg">{name}</h1>
          <div class="plaque paper px-7 pb-7 pt-12 shadow-[0_30px_60px_-30px_rgb(0_0_0/0.9)]">
            {facts.length > 0 && (
              <dl>
                {facts.map((f) => (
                  <div class="grid grid-cols-[6.5rem_1fr] gap-4 px-3 py-3.5 odd:bg-maroon/10">
                    <dt class="text-[0.95rem] text-maroon/65">{f.label}</dt>
                    <dd class="min-w-0 text-[1.05rem] font-semibold [overflow-wrap:anywhere]">
                      {f.value}
                      {f.level !== undefined && (
                        <span class="meter" role="img" aria-label={`Level ${f.level} of 7`}>
                          {INTERVENTION_LEVELS.map((l) => <i class={l.level === f.level ? 'on' : ''} style={`--i:${l.level}`}></i>)}
                        </span>
                      )}
                    </dd>
                  </div>
                ))}
              </dl>
            )}
            <a href={`/map?s=${id}`} class="btn btn-maroon mt-7 w-full">Show on the map</a>
          </div>
        </div>
      </div>
    </div>
  </header>

  <div class="wall-maroon pb-28 pt-14">
    <div data-tabs class="mx-auto max-w-[84rem] px-5 sm:px-8">
      <div role="tablist" aria-label={`${name} sections`} class="tabs flex items-end gap-2 overflow-x-auto" style="scrollbar-width: none" data-tablist>
        {tabs.map((tab) => (
          <a href={`#${tab.key}`} role="tab" id={`tab-${tab.key}`} data-panel={tab.key} aria-controls={tab.key} class="tab shrink-0 whitespace-nowrap" style={tab.tone}>
            {tab.label}
          </a>
        ))}
      </div>

      <section id="history" role="tabpanel" aria-labelledby="tab-history" class="sheet paper px-7 py-10 sm:px-12 sm:py-14">
        <div class="sheet-grid">
          <header class="sheet-head"><p class="sheet-kicker">{name}</p><h2>History</h2><span class="sheet-rule" aria-hidden="true"></span></header>
          <div class="sheet-body">{history ? <p class="prose-sosog">{history}</p> : <p class="text-[1.1rem] text-maroon/70">Historical records for this structure are limited.</p>}</div>
        </div>
      </section>

      {featureStory && (
        <section id="story" role="tabpanel" aria-labelledby="tab-story" class={`sheet px-7 py-10 sm:px-12 sm:py-14 ${accent.sheet} ${accent.ink}`}>
          <div class={`sheet-grid ${photoLayout === 1 ? 'sheet-grid-flip' : ''}`}>
            <header class="sheet-head">
              <p class="sheet-kicker">{name}</p>
              <h2>Feature Story</h2>
              <span class="sheet-rule" aria-hidden="true"></span>
              {heroPhoto && (
                <div class={`relative mt-9 bg-cream p-2 shadow-[0_24px_40px_-24px_rgb(0_0_0/0.8)] ${photoLayout === 1 ? 'rotate-[1deg]' : 'rotate-[-1.2deg]'} ${photoLayout === 2 ? 'mb-12' : ''}`}>
                  <span class={`absolute -top-3 h-6 w-24 ${photoLayout === 1 ? 'left-8 -rotate-3' : 'left-1/2 -translate-x-1/2 rotate-2'} ${accent.tape}`} aria-hidden="true"></span>
                  <img src={heroPhoto} alt={name} width="1200" height="900" loading="lazy" decoding="async" class="aspect-[4/3] w-full object-cover" />
                  {photoLayout === 2 && insetPhoto && (
                    <div class="absolute -bottom-9 -left-3 hidden w-2/5 -rotate-3 bg-cream p-1.5 shadow-[0_24px_40px_-20px_rgb(0_0_0/0.8)] sm:block">
                      <span class={`absolute -top-3 left-4 h-5 w-16 rotate-3 ${accent.tape}`} aria-hidden="true"></span>
                      <img src={insetPhoto} alt="" width="300" height="300" loading="lazy" class="aspect-square w-full object-cover" />
                    </div>
                  )}
                </div>
              )}
            </header>
            <div class="sheet-body">
              {pullQuote && <p class={`sheet-quote font-display ${accent.quote}`}>&ldquo;{pullQuote}&rdquo;</p>}
              <p class={`prose-sosog ${storyIsShort ? 'prose-lead' : ''}`}>{featureStory}</p>
            </div>
          </div>
        </section>
      )}

      <section id="technical" role="tabpanel" aria-labelledby="tab-technical" class="sheet blueprint wall-navy-mid px-7 py-10 sm:px-12 sm:py-14">
        <div class="sheet-grid">
          <header class="sheet-head"><p class="sheet-kicker">{name}</p><h2>Technical Description</h2><span class="sheet-rule" aria-hidden="true"></span></header>
          <div class="sheet-body">{technicalDescription ? <p class="prose-sosog">{technicalDescription}</p> : <p class="text-[1.1rem] text-cream/75">No technical description has been recorded for this structure.</p>}</div>
        </div>
        {intervention && (
          <div class="level" data-level-box data-actual={intervention.level}>
            <div class="level-head">
              <p class="sheet-kicker">Level of intervention</p>
              <p class="level-read">
                <span class="level-name" data-level-name>{intervention.name}</span>
                <span class="level-note" data-level-note>{intervention.note ? `(${intervention.note})` : ''}</span>
              </p>
            </div>
            <div class="level-track">
              <div class="level-bars" role="group" aria-label="The eight levels of intervention, 0 to 7">
                {INTERVENTION_LEVELS.map((l) => (
                  <button type="button" class={`lbar ${l.level === intervention.level ? 'lbar-on' : ''}`} style={`--i:${l.level}`} data-name={l.name} data-note={l.note ?? ''} aria-label={`Level ${l.level}, ${l.name}${l.note ? ` (${l.note})` : ''}`} aria-current={l.level === intervention.level ? 'true' : undefined}>
                    <svg class="lbar-art" viewBox="0 0 64 44" aria-hidden="true" focusable="false" set:html={INTERVENTION_ART[l.level]} />
                    <span class="lbar-no" aria-hidden="true">{l.level}</span>
                    <span class="lbar-name" aria-hidden="true">{l.name}</span>
                  </button>
                ))}
              </div>
              <div class="level-plinth" aria-hidden="true"><span>Less intervention</span><span>More intervention</span></div>
              <p class="level-key" aria-hidden="true">
                <span><i class="key-sw key-o"></i>Original fabric</span>
                <span><i class="key-sw key-n"></i>New work</span>
              </p>
            </div>
          </div>
        )}
      </section>
    </div>
  </div>
</article>

<style>
  /* Every sheet is one label column and one reading column, so the page width is used and the text keeps a comfortable line length. */
  .sheet-grid {
    display: grid;
    gap: 2rem 4rem;
    align-items: start;
  }
  @media (min-width: 64rem) {
    .sheet-grid {
      grid-template-columns: minmax(0, 22rem) minmax(0, 1fr);
    }
    .sheet-grid-flip {
      grid-template-columns: minmax(0, 1fr) minmax(0, 22rem);
    }
    .sheet-grid-flip .sheet-head {
      order: 2;
    }
    .sheet-head {
      position: sticky;
      top: 6.5rem;
    }
  }
  .sheet-kicker {
    font-size: 1rem;
    font-weight: 600;
    opacity: 0.7;
  }
  .sheet-head h2 {
    margin-top: 0.5rem;
    font-family: var(--font-display, inherit);
    font-size: clamp(2.1rem, 3.2vw, 2.9rem);
    line-height: 1.02;
  }
  .sheet-rule {
    display: block;
    margin-top: 1.4rem;
    width: 4.5rem;
    height: 3px;
    background: currentColor;
    opacity: 0.55;
  }
  /* The plaque's level meter: eight solid blocks that rise like steps, the one for this structure filled. */
  .meter {
    display: flex;
    align-items: flex-end;
    gap: 0.22rem;
    max-width: 100%;
    margin-top: 0.6rem;
  }
  .meter i {
    display: block;
    flex: 1 1 0;
    min-width: 0;
    max-width: 1.15rem;
    height: calc(0.45rem + var(--i) * 0.12rem);
    background: color-mix(in srgb, var(--color-maroon) 16%, transparent);
  }
  .meter i.on {
    background: var(--color-maroon);
  }

  /* The level of intervention: eight illustrated cards rising like a podium from level 0 to level 7. Each card draws the same house with the original fabric pale and the new work bright, so the more a level intervenes the more of the house is new. This structure's card is cream under a maroon cap. Pointing at, focusing or tapping another card reads that level out. Wide screens show all eight side by side with the heading and the level name in the empty sky above the shorter cards; narrower screens scroll the cards sideways. */
  .level {
    --orig: color-mix(in srgb, var(--color-cream) 40%, var(--color-ink));
    --new: var(--color-cream);
    --ground: color-mix(in srgb, var(--color-cream) 18%, var(--color-ink));
    position: relative;
    margin-top: 3.25rem;
  }
  .level-head {
    margin-bottom: 1.3rem;
  }
  .level-track {
    position: relative;
    container-type: inline-size;
  }
  .level-bars {
    position: relative;
    display: flex;
    align-items: flex-end;
    gap: 0.75rem;
    padding-top: 0.6rem;
    overflow-x: auto;
    overscroll-behavior-x: contain;
    scroll-snap-type: x proximity;
    scrollbar-width: none;
    margin-inline: -1.75rem;
    padding-inline: 1.75rem;
  }
  @media (min-width: 40rem) {
    .level-bars {
      margin-inline: -3rem;
      padding-inline: 3rem;
    }
  }
  .level-bars::-webkit-scrollbar {
    display: none;
  }
  .lbar {
    position: relative;
    flex: 0 0 9rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    height: calc(12.2rem + var(--i) * 0.3rem);
    padding: 1.3rem 0.7rem 1.1rem;
    scroll-snap-align: center;
    transform-origin: bottom;
    background: color-mix(in srgb, var(--color-ink) 52%, transparent);
    color: color-mix(in srgb, var(--color-cream) 84%, transparent);
    cursor: pointer;
    transition: background-color 0.2s ease, color 0.2s ease, transform 0.25s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .lbar-art {
    display: block;
    flex: none;
    width: 100%;
    height: auto;
    aspect-ratio: 64 / 44;
  }
  .lbar-art :global(.o) {
    fill: var(--orig);
  }
  .lbar-art :global(.n) {
    fill: var(--new);
  }
  .lbar-art :global(.g) {
    fill: var(--ground);
  }
  .lbar-no {
    margin-top: auto;
    font-size: 2.2rem;
    font-weight: 800;
    line-height: 1;
  }
  .lbar-name {
    margin-top: 0.5rem;
    font-size: 0.88rem;
    font-weight: 600;
    line-height: 1.15;
    text-align: center;
  }
  .lbar:hover,
  .lbar:focus-visible,
  .lbar-view {
    background: color-mix(in srgb, var(--color-cream) 22%, var(--color-navy-deep));
    color: var(--color-cream);
    transform: translateY(-0.3rem);
  }
  .lbar:focus-visible {
    outline: 0.18rem solid var(--color-cream);
    outline-offset: 0.2rem;
  }
  .lbar-on,
  .lbar-on:hover,
  .lbar-on:focus-visible {
    --orig: color-mix(in srgb, var(--color-maroon) 30%, var(--color-cream));
    --new: var(--color-maroon);
    --ground: color-mix(in srgb, var(--color-maroon) 16%, var(--color-cream));
    background: var(--color-cream);
    color: var(--color-maroon);
    box-shadow: 0 1.4rem 2rem -1.3rem rgb(0 0 0 / 0.9);
    transform: translateY(-0.4rem);
  }
  .lbar-on::before {
    content: '';
    position: absolute;
    inset: 0 0 auto 0;
    height: 0.45rem;
    background: var(--color-maroon-light);
  }
  .level-plinth {
    display: flex;
    justify-content: space-between;
    align-items: center;
    height: 0.6rem;
    background: color-mix(in srgb, var(--color-cream) 24%, var(--color-navy-deep));
    color: color-mix(in srgb, var(--color-cream) 88%, transparent);
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .level-plinth span {
    display: none;
  }
  .level-key {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.4rem 2rem;
    margin-top: 1.4rem;
    font-size: 0.95rem;
    color: color-mix(in srgb, var(--color-cream) 78%, transparent);
  }
  .level-key span {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    line-height: 1;
  }
  .key-sw {
    display: block;
    width: 1.5rem;
    height: 0.8rem;
  }
  .key-o {
    background: var(--orig);
  }
  .key-n {
    background: var(--new);
  }
  .level-read {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 1.1rem;
    margin-top: 0.6rem;
    min-height: 2.6rem;
  }
  .level-name {
    font-family: var(--font-display, inherit);
    font-size: 2.3rem;
    line-height: 1.05;
  }
  .level-note {
    font-size: 1.12rem;
    opacity: 0.78;
  }
  @container (min-width: 66rem) {
    .level-bars {
      display: grid;
      grid-template-columns: repeat(8, minmax(0, 1fr));
      gap: 0.7rem;
      padding: 0;
      margin-inline: 0;
      overflow: visible;
    }
    .lbar {
      flex: none;
      height: calc(13.4rem + var(--i) * 0.6rem);
      padding: 1.4rem 0.55rem 1.2rem;
    }
    .lbar-no {
      font-size: 2.6rem;
    }
    .level-plinth {
      height: 2.2rem;
      padding-inline: 1.1rem;
    }
    .level-plinth span {
      display: block;
    }
  }
  /* On wide screens the heading and the name of the level sit in the empty sky above the shorter cards, so the podium needs no row of its own for them. */
  @media (min-width: 80rem) {
    .level-head {
      position: absolute;
      top: 0;
      left: 0;
      max-width: 31rem;
      margin: 0;
    }
    .level-track {
      padding-top: 3.1rem;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .lbar {
      animation: bar-rise 0.6s cubic-bezier(0.22, 1, 0.36, 1) both;
      animation-delay: calc(var(--i) * 60ms);
    }
    .lbar-art :global(.n) {
      animation: new-in 0.6s ease both;
      animation-delay: calc(var(--i) * 60ms + 450ms);
    }
    @keyframes bar-rise {
      from {
        opacity: 0;
        transform: scaleY(0.2);
      }
    }
    @keyframes new-in {
      from {
        opacity: 0;
      }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .lbar {
      transition: none;
    }
  }

  .prose-lead {
    font-size: 1.4rem;
    line-height: 1.75;
  }
  .sheet-quote {
    margin-bottom: 2rem;
    max-width: 30ch;
    font-size: clamp(1.5rem, 2.4vw, 2rem);
    line-height: 1.2;
  }
  .sheet-body .prose-sosog > :first-child::first-letter,
  .sheet-body > .prose-sosog::first-letter {
    float: left;
    padding: 0.06em 0.1em 0 0;
    font-family: var(--font-display, inherit);
    font-size: 3.7em;
    line-height: 0.8;
  }
  .plaque {
    border-radius: 50% 50% 0 0 / 3rem 3rem 0 0;
  }
  /* Folder tabs: each tab is the colour of its own sheet, so the one in use joins the sheet beneath it. */
  .tab {
    padding: 0.95rem 1.7rem 0.8rem;
    border-radius: 16px 16px 0 0;
    background: var(--color-maroon-deep);
    color: color-mix(in srgb, var(--color-cream) 82%, transparent);
    font-size: 1.05rem;
    font-weight: 700;
    transform: translateY(8px);
    transition: transform 0.3s var(--ease-out), background-color 0.25s, color 0.25s, padding 0.3s var(--ease-out);
  }
  .tab:hover {
    color: var(--color-cream);
  }
  .tab[aria-selected='true'] {
    background: var(--tab-bg);
    color: var(--tab-fg);
    padding-top: 1.2rem;
    padding-bottom: 1.1rem;
    transform: translateY(0);
  }
  /* Opening a structure at a given tab (#technical from the index pages, #story from the deck) scrolls that sheet to the top of the screen, which put the folder tabs behind the fixed header. The margin leaves room for the tab row above the sheet. */
  :global(html.js) .sheet {
    scroll-margin-top: 4rem;
  }
  :global(html:not(.js)) .sheet + .sheet {
    margin-top: 2.5rem;
  }
  :global(html:not(.js)) .tabs {
    display: none;
  }
  /* Technical sheet: faint drafting grid, like the back of a blueprint. */
  .blueprint {
    background-image:
      linear-gradient(color-mix(in srgb, var(--color-cream) 7%, transparent) 1px, transparent 1px),
      linear-gradient(90deg, color-mix(in srgb, var(--color-cream) 7%, transparent) 1px, transparent 1px),
      var(--grain);
    background-size: 32px 32px, 32px 32px, auto;
  }
</style>

<script>
  // Progressive enhancement: with JavaScript the tabs show one panel at a time (History first); without it every section stays visible and the tab links jump down the page.
  document.querySelectorAll<HTMLElement>('[data-tabs]').forEach((root) => {
    const tabs = Array.from(root.querySelectorAll<HTMLAnchorElement>('[role="tab"]'));
    const panels = new Map(tabs.map((t) => [t.dataset.panel!, document.getElementById(t.dataset.panel!)!]));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let current: string | null = null;

    function show(key: string, moveFocus = false) {
      const first = current === null;
      tabs.forEach((tab) => {
        const selected = tab.dataset.panel === key;
        tab.setAttribute('aria-selected', String(selected));
        tab.tabIndex = selected ? 0 : -1;
        if (selected && moveFocus) tab.focus();
      });
      const next = panels.get(key)!;
      const previous = current ? panels.get(current) : null;
      const swap = () => {
        panels.forEach((panel, panelKey) => {
          panel.hidden = panelKey !== key;
        });
        if (!first && !reduced) next.animate([{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }], { duration: 260, easing: 'ease-out' });
      };
      if (!first && !reduced && previous && previous !== next) {
        // The old sheet fades out quickly, the page keeps its height meanwhile, then the new sheet fades in, so the panel never blinks empty.
        const holder = previous.parentElement!;
        holder.style.minHeight = `${previous.offsetHeight}px`;
        previous.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 110, easing: 'ease-in' }).onfinish = () => {
          swap();
          window.setTimeout(() => (holder.style.minHeight = ''), 300);
        };
      } else swap();
      current = key;
    }

    const fromHash = () => {
      const key = location.hash.slice(1);
      return panels.has(key) ? key : tabs[0].dataset.panel!;
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', (event) => {
        event.preventDefault();
        if (tab.dataset.panel === current) return;
        history.replaceState(null, '', `#${tab.dataset.panel}`);
        show(tab.dataset.panel!);
      });
      tab.addEventListener('keydown', (event) => {
        if (event.key !== 'ArrowRight' && event.key !== 'ArrowLeft') return;
        event.preventDefault();
        const next = tabs[(index + (event.key === 'ArrowRight' ? 1 : -1) + tabs.length) % tabs.length];
        history.replaceState(null, '', `#${next.dataset.panel}`);
        show(next.dataset.panel!, true);
      });
    });

    window.addEventListener('hashchange', () => show(fromHash()));
    show(fromHash());
  });

  // The level gauge on the Technical Description sheet: pointing at or focusing a block reads that level out and leaving goes back to this structure's own level. On a touch screen a tap holds a level until it is tapped again or the reader taps elsewhere.
  document.querySelectorAll<HTMLElement>('[data-level-box]').forEach((box) => {
    const actual = Number(box.dataset.actual);
    const bars = Array.from(box.querySelectorAll<HTMLButtonElement>('.lbar'));
    const name = box.querySelector<HTMLElement>('[data-level-name]')!;
    const note = box.querySelector<HTMLElement>('[data-level-note]')!;
    let pinned: number | null = null;
    let lastPointer = '';

    const view = (n: number) => {
      name.textContent = bars[n].dataset.name ?? '';
      note.textContent = bars[n].dataset.note ? `(${bars[n].dataset.note})` : '';
      bars.forEach((bar, i) => bar.classList.toggle('lbar-view', i === n && n !== actual));
    };
    const rest = () => view(pinned ?? actual);

    bars.forEach((bar, n) => {
      bar.addEventListener('pointerenter', (event) => {
        if (event.pointerType === 'mouse') {
          pinned = null;
          view(n);
        }
      });
      bar.addEventListener('pointerdown', (event) => {
        lastPointer = event.pointerType;
      });
      bar.addEventListener('focus', () => view(n));
      bar.addEventListener('click', () => {
        if (lastPointer === 'touch' || lastPointer === 'pen') {
          pinned = pinned === n || n === actual ? null : n;
          rest();
        } else {
          view(n);
        }
        lastPointer = '';
      });
    });
    document.addEventListener('pointerdown', (event) => {
      if (pinned !== null && !box.contains(event.target as Node)) {
        pinned = null;
        rest();
      }
    });
    box.querySelector('.level-bars')!.addEventListener('pointerleave', rest);
    box.addEventListener('focusout', (event) => {
      if (!box.contains(event.relatedTarget as Node | null)) rest();
    });
    bars.forEach((bar, n) =>
      bar.addEventListener('keydown', (event) => {
        const next = event.key === 'ArrowRight' ? n + 1 : event.key === 'ArrowLeft' ? n - 1 : null;
        if (next === null || !bars[next]) return;
        event.preventDefault();
        bars[next].focus();
      })
    );

    // Where the cards scroll sideways, bring this structure's own card to the middle as soon as the sheet is on screen.
    const track = box.querySelector<HTMLElement>('.level-bars')!;
    new ResizeObserver(() => {
      if (track.scrollWidth <= track.clientWidth) return;
      track.scrollLeft = bars[actual].offsetLeft - (track.clientWidth - bars[actual].offsetWidth) / 2;
    }).observe(track);
  });
</script>
