---
import Layout from '../layouts/Layout.astro';
import PageHeader from '../components/PageHeader.astro';
import MunicipalityArcade from '../components/MunicipalityArcade.astro';
import { getCollection } from 'astro:content';
import { carouselItems, emptyMunicipalities } from '../lib/structures';
import { getStructurePhoto } from '../lib/photos';

const structures = await getCollection('structures');
const items = carouselItems(structures, (key) => getStructurePhoto(key, 'thumb') !== null);
const empty = emptyMunicipalities(structures);
const emptyList = new Intl.ListFormat('en', { style: 'long', type: 'conjunction' }).format(empty);
---
<Layout title="Explore" tone="cream">
  <main id="main" class="wall-cream">
    <PageHeader tone="cream" title="Choose a municipality" intro="Open an arch to see the structures documented inside that municipality." />
    <section class="pb-24 pt-6">
      <MunicipalityArcade items={items} />
      {empty.length > 0 && <p class="gutter mt-14 text-[1.05rem] text-maroon/75">No structures are documented in {emptyList}.</p>}
    </section>
  </main>
</Layout>
