---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Page not found">
  <main id="main" class="wall-deep">
    <div class="mx-auto flex min-h-[68vh] max-w-[84rem] flex-col justify-center px-5 py-24 sm:px-8">
      <h1 class="display-xl max-w-[10ch]">Page not found</h1>
      <p class="lead mt-8 text-cream/80">That page is not part of SOSOG. Try the map or the list of municipalities.</p>
      <p class="mt-10 flex flex-wrap gap-3">
        <a href="/map" class="btn">Open the map</a>
        <a href="/explore" class="btn btn-navy">Explore</a>
      </p>
    </div>
  </main>
</Layout>
