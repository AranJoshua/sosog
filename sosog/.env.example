# Copy to .env for local runs of `npm run sync:sheet` / `npm run build`.
# In Cloudflare Workers Builds, set the real values as BUILD secrets (the
# Worker's Settings > Build > Variables and secrets), not as plain variables.
# Do not use `wrangler secret put` for these: that sets runtime secrets, which
# the build cannot read. Never commit a real .env file.
# See AGENTS.md "Deployment" for the full reasoning.

# Publish-to-web CSV URL for the client's Google Sheet (File > Share >
# Publish to web, on the tab that holds only the public schema fields).
# Required. sync-sheet.ts and validate-data.ts both read this.
SHEET_CSV_URL=

# Gmail account used only to send the sync-failure notification email.
# Use a dedicated 2FA-enabled account made for this project, not anyone's
# personal Gmail, so an unrelated password change can't silently revoke
# the app password. GMAIL_APP_PASSWORD is the 16-character app password,
# not the account's login password.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Where the failure email gets sent (client + dev team). Comma-separate
# multiple addresses if mailer.ts is extended to support that; right now
# it expects a single "to" value.
ALERT_EMAIL_TO=

# Photos are committed to the repo (see AGENTS.md), so no Google Drive or
# service-account credential is needed anywhere in this project.
