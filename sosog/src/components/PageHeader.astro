---
interface Props {
  title: string;
  /** Short line under the title. */
  intro?: string;
  tone?: 'maroon' | 'navy' | 'ink' | 'cream';
  /** Photograph shown in an arched doorway beside the title. */
  photo?: string | null;
  photoAlt?: string;
}
const { title, intro, tone = 'maroon', photo = null, photoAlt = '' } = Astro.props;
const wall = { maroon: 'wall-deep', navy: 'wall-navy', ink: 'wall-ink', cream: 'wall-cream' }[tone];
const frame = tone === 'cream' ? 'var(--color-maroon)' : 'var(--color-cream)';
---
<header class={`${wall} relative overflow-hidden`}>
  <div class:list={['mx-auto grid max-w-[84rem] gap-8 px-5 sm:px-8', photo ? 'pt-12 sm:pt-16 lg:grid-cols-[minmax(0,1.3fr)_minmax(0,0.7fr)] lg:items-center lg:gap-16' : 'pb-14 pt-14 sm:pb-20 sm:pt-20']}>
    <div class:list={[photo ? 'pb-8 lg:pb-0' : '']}>
      <slot name="back" />
      <h1 class="display-lg mt-2 max-w-[18ch]">{title}</h1>
      {intro && <p class="lead mt-7 max-w-[40rem] opacity-90">{intro}</p>}
      <slot />
    </div>
    {photo && (
      <div class="ph-door mx-auto w-full max-w-[22rem] self-end lg:mr-0" style={`--frame:${frame}`}>
        <div class="ph-frame">
          <img src={photo} alt={photoAlt} width="1600" height="1200" decoding="async" fetchpriority="high" />
        </div>
      </div>
    )}
  </div>
</header>

<style>
  /* The photograph sits in an arched doorway that opens when the page loads. */
  .ph-frame {
    aspect-ratio: 3 / 3.6;
    padding: 0.85rem 0.85rem 0;
    background: var(--frame);
    border-radius: 999px 999px 0 0;
    overflow: hidden;
  }
  .ph-frame img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 999px 999px 0 0;
  }
  :global(html.js) .ph-door {
    animation: ph-in 0.45s ease-out both;
  }
  @keyframes ph-in {
    from {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .ph-door {
      animation: none;
    }
  }
</style>
